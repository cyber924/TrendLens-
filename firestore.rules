
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 기본 규칙: 읽기는 공개(익명), 생성/수정/삭제는 소유자만
    match /{collection}/{docId} {
      allow create: if request.auth != null;
      allow read: if true;
      allow update, delete: if isOwner(resource.data.createdBy);
    }
    
    match /hot100_items/{itemId} {
      allow read;
      allow write: if request.auth != null;
    }

    match /studio_images/{imageId} {
       allow create: if request.auth != null;
       allow read: if true;
       allow update, delete: if isOwner(resource.data.userId);
    }

    match /uploadedFiles/{fileId} {
       allow create: if request.auth != null;
       allow read: if true;
       allow update, delete: if isOwner(resource.data.uploadedBy);
    }

    match /structured_pages/{pageId} {
       allow create: if request.auth != null;
       allow read: if true;
       allow update, delete: if isOwner(resource.data.createdBy);
    }
  }
}
// Storage 보안 규칙과의 최종 동기화를 완료했습니다. (ID: final_storage_sync_1778566100000)
